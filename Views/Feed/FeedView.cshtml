@{
    Layout = null;
}
@model HackaTec.Models.ViewModels.FeedViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Feed de Necesidades - LAZO</title>
    <link rel="stylesheet" href="~/styles.css">
</head>
<body>
    <div class="app-container">
        <nav class="navbar">
            <div class="navbar__brand">
                <img src="~/Images/logo.png" class="navbar__logo" alt="Logo LAZO" />
                <span class="navbar__title">LAZO</span>
            </div>
            <div class="navbar__nav-group">
                <ul class="navbar__menu">
                    <li><a href="chat.html" class="navbar__link">Mensajes</a></li>
                    <li><a href="perfil-donante.html" class="navbar__link">Mi Perfil</a></li>
                    <li><a href="login.html" class="navbar__link navbar__link--logout" onclick="return confirm('¿Cerrar sesión de la plataforma?')">Cerrar Sesión 🚪</a></li>
                </ul>
            </div>
        </nav>

        <main class="main-content">
            <section class="search-container">
                <form action="#" method="GET" class="search-box">
                    <input type="text" class="form-control" placeholder="Buscar por material (ej: pintura, tubos) o nombre de escuela..." aria-label="Buscador de necesidades">
                    <button type="submit" class="btn btn--primary">Buscar</button>
                </form>
            </section>

            <div class="tabs-container">
       
                <button class="tab-btn" onclick="switchTab(event, 'feed-necesidades')">📑 Necesidades</button>
                <button class="tab-btn" onclick="switchTab(event, 'feed-agradecimientos')">❤️ Agradecimientos</button>
            </div>

            

            <div id="feed-necesidades" class="tab-content">
                <section class="feed">
                    <article class="card post">
                        <div class="post__header">
                            <span>Escuela Primaria Benito Juárez (CCT: 05EPR0123X)</span>
                            <span>Hace 10 min</span>
                        </div>
                        <h2 class="post__title">Falta de pintura acrílica para fachadas de salones</h2>
                        <p class="post__content">Tenemos 3 salones vandalizados debido a las lluvias y graffitis. Requerimos aproximadamente 2 o 3 cubetas de pintura acrílica blanca o azul que les haya sobrado de sus construcciones.</p>
                        <div class="post__images">
                            <img src="https://via.placeholder.com/300" alt="Evidencia" class="post__img">
                        </div>
                        <div class="text-right">
                            <a href="chat.html?post_id=101" class="btn btn--primary">Quiero Donar</a>
                        </div>
                    </article>

                    <article class="card post post--cubierto">
                        <div class="post__header">
                            <span>Kinder Justo Sierra</span>
                            <span>Ayer</span>
                            <span class="badge-status badge-status--cubierto">Cubierto</span>
                        </div>
                        <h2 class="post__title">Se solicitan tubos PVC para drenaje de patio</h2>
                        <p class="post__content">Buscamos tramos de tubo de 4 pulgadas para canalizar el agua del patio escolar.</p>
                    </article>
                </section>
            </div>

            <div id="feed-agradecimientos" class="tab-content">
                <section class="feed">
                    <div class="card post post--thanks">
                        <div class="post__header">
                            <span>Kinder Justo Sierra</span>
                            <span>Ayer</span>
                            <span style="font-weight: bold; color: var(--success);">❤️ Reconocimiento</span>
                        </div>
                        <h2 class="post__title" style="color: var(--success);">¡Gracias a JuanPerez!</h2>
                        <p class="post__content">Queremos agradecer profundamente al donante Carlos Mendoza por hacernos llegar de forma altruista los 3 tubos de PVC para solucionar el problema del drenaje del patio escolar.</p>
                    </div>
                </section>
            </div>

        </main>
    </div>

    <script>
            function switchTab(event, tabId) {
                // Ocultar todos los bloques de contenido del feed
                const contents = document.querySelectorAll('.tab-content');
                contents.forEach(content => content.classList.remove('active'));

                // Quitar el estado activo a los botones de pestañas
                const buttons = document.querySelectorAll('.tab-btn');
                buttons.forEach(btn => btn.classList.remove('active'));

                // Mostrar el contenedor de la pestaña seleccionada
                document.getElementById(tabId).classList.add('active');

                // Marcar el botón actual con la barra inferior del CSS
                event.currentTarget.classList.add('active');
            }
    </script>
</body>
</html>
