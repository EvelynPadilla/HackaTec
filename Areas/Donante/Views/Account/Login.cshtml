@{
    Layout = null;
}
@model HackaTec.Areas.Donante.ViewModels.LoginDonanteViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar Sesión Donante</title>
    <link rel="stylesheet" href="~/styles.css">
</head>
<body>
    <div class="app-container" style="justify-content: center; align-items: center; background: linear-gradient(135deg, var(--primary-light) 0%, var(--primary) 100%);">
        <main class="main-content" style="max-width: 400px; width: 100%; padding: 1rem;">
            <div class="card" style="margin-bottom: 0; padding: 2rem; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">

                <div style="text-align: center; margin-bottom: 2rem;">
                    <h1 style="color: var(--primary); font-size: 1.8rem; margin-bottom: 0.25rem;">🌱 Acceso Donantes</h1>
                    <p style="color: var(--gray); font-size: 0.9rem;">Apoya a la infraestructura escolar</p>
                </div>

                @if (ViewBag.MostrarError == true)
                {
                    <div class="alert alert-error" style="background:#fee2e2; color:#b91c1c; padding:0.75rem; border-radius:6px; margin-bottom:1rem;">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    </div>
                }

                <form asp-area="Donante" asp-controller="Account" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label asp-for="Correo">Correo Electrónico *</label>
                        <input asp-for="Correo" class="form-control" type="email" placeholder="ejemplo@correo.com" required autocomplete="email">
                        <span asp-validation-for="Correo" class="text-danger" style="font-size:0.8rem;"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ContrasenaHash">Contraseña *</label>
                        <input asp-for="ContrasenaHash" class="form-control" type="password" placeholder="••••••••" required autocomplete="current-password">
                        <span asp-validation-for="ContrasenaHash" class="text-danger" style="font-size:0.8rem;"></span>
                    </div>

               

                    <button type="submit" class="btn btn--primary btn--block" style="padding: 0.75rem;">
                        Ingresar como Donante
                    </button>
                </form>

                <div style="margin-top: 1.5rem; text-align: center; border-top: 1px solid var(--light); padding-top: 1rem; font-size: 0.85rem; display: flex; flex-direction: column; gap: 0.5rem;">
                    <div>
                        <span style="color: var(--dark);">¿No tienes cuenta?</span>
                        <a asp-area="Donante" asp-controller="Account" asp-action="Registrar" style="color: var(--primary-light); font-weight: bold; text-decoration: none;">Regístrate aquí</a>
                    </div>
                  
                </div>

            </div>
        </main>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>