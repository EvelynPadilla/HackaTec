<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar Sesión Donante - Mi-Proyecto</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <div class="app-container" style="justify-content: center; align-items: center; background: linear-gradient(135deg, var(--primary-light) 0%, var(--primary) 100%);">
        <main class="main-content" style="max-width: 400px; width: 100%; padding: 1rem;">
            <div class="card" style="margin-bottom: 0; padding: 2rem; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">

                <div style="text-align: center; margin-bottom: 2rem;">
                    <h1 style="color: var(--primary); font-size: 1.8rem; margin-bottom: 0.25rem;">🌱 Acceso Donantes</h1>
                    <p style="color: var(--gray); font-size: 0.9rem;">Apoya a la infraestructura escolar</p>
                </div>

                <form action="feed.html" method="POST">

                    <div class="form-group">
                        <label for="donante-email">Correo Electrónico *</label>
                        <input type="email" id="donante-email" class="form-control" placeholder="ejemplo@correo.com" required autocomplete="email">
                    </div>

                    <div class="form-group">
                        <label for="donante-password">Contraseña *</label>
                        <input type="password" id="donante-password" class="form-control" placeholder="••••••••" required autocomplete="current-password">
                    </div>

                    <div style="margin-bottom: 1.5rem; text-align: right;">
                        <a href="#" style="font-size: 0.85rem; color: var(--primary-light); text-decoration: none;">¿Olvidaste tu contraseña?</a>
                    </div>

                    <button type="submit" class="btn btn--primary btn--block" style="padding: 0.75rem;">
                        Ingresar como Donante
                    </button>
                </form>

                <div style="margin-top: 1.5rem; text-align: center; border-top: 1px solid var(--light); padding-top: 1rem; font-size: 0.85rem; display: flex; flex-direction: column; gap: 0.5rem;">
                    <div>
                        <span style="color: var(--dark);">¿No tienes cuenta?</span>
                        <a href="registro-donante.html" style="color: var(--primary-light); font-weight: bold; text-decoration: none;">Regístrate aquí</a>
                    </div>
                    <div style="margin-top: 0.5rem;">
                        <a href="login.html" style="color: var(--gray); text-decoration: none;">¿Eres una Escuela? Entra aquí</a>
                    </div>
                </div>

            </div>
        </main>
    </div>
</body>
</html>