@model HackaTec.Areas.Admin.ViewModels.AdminPanelViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel de Control GIE - Admin</title>
    <link rel="stylesheet" href="~/styles.css">
</head>
<body>
    <div class="app-container">
        <nav class="navbar">
            <div class="navbar__brand">🔒 Panel Administrador (GIE)</div>
            <ul class="navbar__menu">
                <li><a href="#" class="navbar__link">Salir</a></li>
            </ul>
        </nav>
        <main class="main-content">
            <!-- Mostrar mensajes de éxito/error -->
            @if (TempData["Mensaje"] != null)
            {
                <div class="alert alert-@(TempData["TipoMensaje"] == "success" ? "success" : "error")">
                    @TempData["Mensaje"]
                </div>
            }

            <div class="card">
                <h3>Dar de Alta Nueva Institución Educativa (Validación Offline)</h3>
                <br>
                <form method="post" asp-action="RegistrarInstitucion" asp-controller="Home">
                    
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem;">
                        <div class="form-group">
                            <label>Nombre de la Escuela *</label>
                            <input type="text" class="form-control" asp-for="@Model.FormularioInstitucion.NombreEscuela" required>
                            <span asp-validation-for="@Model.FormularioInstitucion.NombreEscuela" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label>Clave Centro de Trabajo (CCT) *</label>
                            <input type="text" class="form-control" asp-for="@Model.FormularioInstitucion.CCT" minlength="10" maxlength="10" placeholder="Ej. 05EPR0123X" required>
                            <span asp-validation-for="@Model.FormularioInstitucion.CCT" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label>Dirección de la Escuela *</label>
                            <input type="text" class="form-control" asp-for="@Model.FormularioInstitucion.DireccionEscuela" required>
                            <span asp-validation-for="@Model.FormularioInstitucion.DireccionEscuela" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label>Persona Responsable *</label>
                            <input type="text" class="form-control" asp-for="@Model.FormularioInstitucion.Responsable" required>
                            <span asp-validation-for="@Model.FormularioInstitucion.Responsable" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label>Teléfono de la Escuela *</label>
                            <input type="tel" class="form-control" asp-for="@Model.FormularioInstitucion.TelefonoEscuela" minlength="10" maxlength="10" pattern="[0-9]{10}" placeholder="10 dígitos numéricos" required>
                            <span asp-validation-for="@Model.FormularioInstitucion.TelefonoEscuela" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label>Teléfono de la Persona Responsable*</label>
                            <input type="tel" class="form-control" asp-for="@Model.FormularioInstitucion.TelefonoResponsable" minlength="10" maxlength="10" pattern="[0-9]{10}" placeholder="10 dígitos numéricos" required>
                            <span asp-validation-for="@Model.FormularioInstitucion.TelefonoResponsable" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label>Contraseña *</label>
                            <input type="password" class="form-control"  minlength="10" maxlength="10" pattern="[0-9]{10}" placeholder="10 dígitos numéricos" required>
                            <span asp-validation-for="@Model.FormularioInstitucion.TelefonoResponsable" class="text-danger"></span>
                        </div>
                    </div>
                    <button type="submit" class="btn btn--success">Registrar y Activar Escuela</button>
                </form>
            </div>

            <div class="card">
                <h3>Instituciones Registradas</h3>
                <br>
                <div style="overflow-x: auto;">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>CCT</th>
                                <th>Nombre</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ListaInstituciones != null && Model.ListaInstituciones.Any())
                            {
                                foreach (var institucion in Model.ListaInstituciones)
                                {
                                    <tr>
                                        <td>@institucion.CCT</td>
                                        <td>@institucion.NombreEscuela</td>
                                        <td>
                                            @if (institucion.Estado)
                                            {
                                                <span class="badge-status badge-status--activo">Activo</span>
                                            }
                                            else
                                            {
                                                <span class="badge-status badge-status--inactivo">Inactivo</span>
                                            }
                                        </td>
                                        <td>
                                            <form method="post" asp-action="CambiarEstadoInstitucion" style="display: inline;">
                                                <input type="hidden" name="id" value="@institucion.Id" />
                                                <input type="hidden" name="cct" value="@institucion.CCT" />
                                                @if (institucion.Estado)
                                                {
                                                    <button type="submit" class="btn btn--danger" onclick="return confirm('¿Seguro que desea desactivar esta institución?')">
                                                        Desactivar
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn--warning" onclick="return confirm('¿Seguro que desea activar esta institución?')">
                                                        Activar
                                                    </button>
                                                }
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" style="text-align: center;">No hay instituciones registradas</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>