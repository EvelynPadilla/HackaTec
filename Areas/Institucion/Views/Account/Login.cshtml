@model HackaTec.Areas.Institucion.ViewModels.LoginInstitucionesViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar Sesión - Mi-Proyecto</title>
    <link rel="stylesheet" href="~/styles.css">
</head>
<body>
    <div class="app-container" style="justify-content: center; align-items: center; background: linear-gradient(135deg, var(--primary) 0%, #1e40af 100%);">
        <main class="main-content" style="max-width: 420px; width: 100%; padding: 1rem;">
            <div class="card" style="margin-bottom: 0; padding: 2rem; border-radius: 12px; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3);">
                <div style="text-align: center; margin-bottom: 2rem;">
                    <h1 style="color: var(--primary); font-size: 1.8rem; margin-bottom: 0.25rem;">🌱 Mi-Proyecto</h1>
                    <p style="color: var(--gray); font-size: 0.9rem;">Acceso para Escuelas y Donantes</p>
                </div>

                <form asp-action="Login" asp-controller="Account" asp-area="Institucion" method="POST">
                    <div class="form-group">
                        <label for="usuario">Clave CCT</label>
                        <input asp-for="Correo_CCT" type="text" class="form-control" placeholder="Ej: 05EPR0123X" required>
                    </div>

                    <div class="form-group">
                        <label for="password">Contraseña *</label>
                        <input type="password" asp-for="Contrasena" class="form-control" placeholder="••••••••" required>
                    </div>

                    <div style="margin-bottom: 1.5rem; text-align: right;">
                        <a href="#" style="font-size: 0.85rem; color: var(--primary-light); text-decoration: none;">¿Olvidaste tu contraseña?</a>
                    </div>

                    <button type="submit" class="btn btn--primary btn--block" style="padding: 0.75rem;">Ingresar al Sistema</button>
                </form>

                <div style="margin-top: 1.5rem; text-align: center; border-top: 1px solid var(--light); padding-top: 1.5rem; font-size: 0.9rem;">
                    <p style="color: var(--dark);">¿Eres un donante nuevo?</p>
                    <a href="registro-donante.html" style="color: var(--primary-light); font-weight: bold; text-decoration: none;">Regístrate aquí</a>
                </div>
            </div>
        </main>
    </div>
</body>
</html>