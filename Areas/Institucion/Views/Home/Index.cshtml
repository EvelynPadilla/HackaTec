@model HackaTec.Areas.Institucion.ViewModels.IndexViewModel2
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Perfil - Portal Institucional</title>
    <link rel="stylesheet" href="~/styles.css" asp-append-version="true">
</head>
<body>
    <div class="app-container">
        <nav class="navbar">
            <div class="navbar__brand">
                <img src="/Images/logo.png" class="navbar__logo" alt="Logo LAZO" />
                <span class="navbar__title">LAZO</span>
            </div>
            <div class="navbar__nav-group">
                <ul class="navbar__menu">
                    <li><a asp-action="Feed" asp-controller="Feed" class="navbar__link">Feed</a></li>
                    <li><a asp-action="Start" asp-controller="Chat" class="navbar__link">Mensajes <span class="badge">1</span></a></li>
                    <li><a asp-action="Index" asp-controller="Home" asp-area="Institucion" class="navbar__link" style="text-decoration: underline;">Mi Perfil</a></li>
                    <li><a asp-action="Logout" asp-controller="Account" class="navbar__link navbar__link--logout" onclick="return confirm('¿Cerrar sesión de la plataforma?')">Cerrar Sesión 🚪</a></li>
                </ul>
            </div>
        </nav>

        <main class="main-content" style="max-width: 900px;">

            <section class="card" style="border-top: 5px solid var(--primary); display: flex; flex-wrap: wrap; gap: 1.5rem; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
                <div>
                    <h1 style="color: var(--primary); margin-bottom: 0.5rem;">@Model.NombreEscuela</h1>
                    <p style="color: var(--dark); font-weight: 600; margin-bottom: 0.25rem;">🏫 Clave CCT: <span style="color: var(--primary-light);">@Model.Cct</span></p>
                    <p style="color: var(--gray); font-size: 0.9rem;">@Model.Direccion</p>
                </div>

                <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                    <a asp-action="PublicarNecesidad" asp-controller="Home" asp-area="Institucion" class="btn btn--success" style="display: inline-flex; align-items: center; gap: 0.5rem;">
                        📢 Publicar Necesidad
                    </a>
                    <a asp-action="PublicarAgradecimiento" asp-controller="Home" asp-area="Institucion" class="btn btn--primary" style="display: inline-flex; align-items: center; gap: 0.5rem;">
                        ➕ Crear Agradecimiento
                    </a>
                </div>
            </section>

            <div class="tabs-container">
                <button class="tab-btn active" onclick="switchTab(event, 'tab-necesidades')">📑 Necesidades (@Model.Publicaciones.Count)</button>
                <button class="tab-btn" onclick="switchTab(event, 'tab-agradecimientos')">❤️ Agradecimientos (@Model.PublicacionesAgradecimiento.Count)</button>
            </div>

            <!-- Tab de Necesidades -->
            <div id="tab-necesidades" class="tab-content active">
                <h2 style="color: var(--primary); font-size: 1.25rem; margin-bottom: 1rem;">📑 Historial de Requerimientos Escolares</h2>

                @if (Model.Publicaciones != null && Model.Publicaciones.Any())
                {
                    <div class="feed">
                        @foreach (var necesidad in Model.Publicaciones)
                        {
                            var claseEstado = necesidad.Estado == true ? "badge-status--activo" : "badge-status--cubierto";
                            var textoEstado = necesidad.Estado == true ? "Activo" : "Cubierto";

                            <article class="card post @(necesidad.Estado == false ? "post--cubierto" : "")">
                                <div class="post__header">
                                    <span class="badge-status @claseEstado">Estatus: @textoEstado</span>
                                    <span>Publicado el: @(necesidad.Fecha != null ? necesidad.Fecha.Value.ToString("dd/MM/yyyy") : "Fecha no disponible")</span>
                                </div>
                                <h3 class="post__title" style="margin-top: 0.5rem;">@necesidad.Titulo</h3>
                                <p class="post__content" style="margin-top: 0.5rem;">@necesidad.Descripcion</p>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="card" style="text-align: center; padding: 3rem;">
                        <p style="color: var(--gray);">No hay necesidades publicadas aún.</p>
                        <a asp-action="PublicarNecesidad" asp-controller="Home" asp-area="Institucion" class="btn btn--success" style="margin-top: 1rem;">Publicar mi primera necesidad</a>
                    </div>
                }
            </div>

            <!-- Tab de Agradecimientos -->
            <div id="tab-agradecimientos" class="tab-content">
                <h2 style="color: var(--success); font-size: 1.25rem; margin-bottom: 1rem;">❤️ Muro de Reconocimientos Comunitarios</h2>

                @if (Model.PublicacionesAgradecimiento != null && Model.PublicacionesAgradecimiento.Any())
                {
                    <div class="feed">
                        @foreach (var agradecimiento in Model.PublicacionesAgradecimiento)
                        {
                            <div class="card post post--thanks">
                                <div class="post__header">
                                    <span style="font-weight: bold; color: var(--success);">❤️ Agradecimiento a Donante #@agradecimiento.IdUsuarioDonante</span>
                                    <span>@(agradecimiento.Fecha != null ? agradecimiento.Fecha.Value.ToString("dd/MM/yyyy") : "Fecha no disponible")</span>
                                </div>
                                <p style="font-size: 0.95rem; margin-top: 0.5rem;">@agradecimiento.Descripcion</p>
                                @if (!string.IsNullOrEmpty(agradecimiento.RutaFotografia))
                                {
                                    <div style="margin-top: 1rem;">
                                        <img src="@agradecimiento.RutaFotografia" alt="Evidencia de agradecimiento" style="max-width: 100%; border-radius: var(--border-radius);" />
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="card" style="text-align: center; padding: 3rem;">
                        <p style="color: var(--gray);">No hay agradecimientos publicados aún.</p>
                        <a asp-action="PublicarAgradecimiento" asp-controller="Home" asp-area="Institucion" class="btn btn--primary" style="margin-top: 1rem;">Crear mi primer agradecimiento</a>
                    </div>
                }
            </div>

        </main>
    </div>

    <script>
            function switchTab(event, tabId) {
                // 1. Ocultar todos los bloques de contenido de pestañas
                const contents = document.querySelectorAll('.tab-content');
                contents.forEach(content => content.classList.remove('active'));

                // 2. Quitar la línea activa de todos los botones de la barra superior
                const buttons = document.querySelectorAll('.tab-btn');
                buttons.forEach(btn => btn.classList.remove('active'));

                // 3. Mostrar el bloque de la pestaña seleccionada
                document.getElementById(tabId).classList.add('active');

                // 4. Marcar el botón actual como activo
                event.currentTarget.classList.add('active');
            }

            // Inicializar la pestaña activa al cargar la página
            document.addEventListener('DOMContentLoaded', function() {
                // Asegurar que la pestaña de necesidades está visible por defecto
                const necesidadesTab = document.getElementById('tab-necesidades');
                const agradecimientosTab = document.getElementById('tab-agradecimientos');
            
                if (necesidadesTab) {
                    necesidadesTab.classList.add('active');
                }
                if (agradecimientosTab) {
                    agradecimientosTab.classList.remove('active');
                }
            });
    </script>
</body>
</html>