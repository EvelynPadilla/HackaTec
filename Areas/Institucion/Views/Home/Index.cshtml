@model HackaTec.Areas.Institucion.ViewModels.IndexViewModel2
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Perfil - Portal Institucional</title>
    <link rel="stylesheet" href="~/styles.css" asp-append-version="true">
</head>
<body>
    <div class="app-container">
        <nav class="navbar">
            <div class="navbar__brand">
                <img src="/Images/logo.png" class="navbar__logo" alt="Logo LAZO" />
                <span class="navbar__title">LAZO</span>
            </div>
            <div class="navbar__nav-group">
                <ul class="navbar__menu">
                    <li><a href="/Feed" class="navbar__link">Feed</a></li>
                    <li><a href="/Chat" class="navbar__link">Mensajes <span class="badge">1</span></a></li>
                    <li><a href="#" class="navbar__link" style="text-decoration: underline;">Mi Perfil</a></li>
                    <li><a href="/Account/Logout" class="navbar__link navbar__link--logout" onclick="return confirm('¿Cerrar sesión de la plataforma?')">Cerrar Sesión 🚪</a></li>
                </ul>
            </div>
        </nav>

        <main class="main-content" style="max-width: 900px;">

            <section class="card" style="border-top: 5px solid var(--primary); display: flex; flex-wrap: wrap; gap: 1.5rem; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
                <div>
                    <h1 style="color: var(--primary); margin-bottom: 0.5rem;">@Model.NombreEscuela</h1>
                    <p style="color: var(--dark); font-weight: 600; margin-bottom: 0.25rem;">🏫 Clave CCT: <span style="color: var(--primary-light);">@Model.Cct</span></p>
                    <p style="color: var(--gray); font-size: 0.9rem;">@Model.Direccion</p>
                </div>

                <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                    <a href="/publicar-necesidad.html" class="btn btn--success" style="display: inline-flex; align-items: center; gap: 0.5rem;">
                        📢 Publicar Necesidad
                    </a>
                    <a href="/publicar-necesidad.html" class="btn btn--primary" style="display: inline-flex; align-items: center; gap: 0.5rem;">
                        ➕ Crear Agradecimiento
                    </a>
                </div>
            </section>

            <div class="tabs-container">
                <button class="tab-btn" asp-action="PublicarNecesidad" asp-controller="Home" asp-area="Institucion">📑 Necesidades</button>
                <button class="tab-btn" asp-action="Agradecimientos" asp-controller="Home" asp-area="Institucion">❤️ Agradecimientos</button>
            </div>

            <div id="tab-general" class="tab-content active">
                <h2 style="color: var(--primary); font-size: 1.25rem; margin-bottom: 1rem;">Resumen de Actividad Reciente</h2>

                <div class="feed">
                    @foreach (var necesidad in Model.Publicaciones)
                    {
                        var claseEstado = necesidad.Estado==true ? "badge-status--activo" : "badge-status--cubierto";
                        var textoEstado = necesidad.Estado==true ? "Activo" : "Cubierto";

                        <article class="card post @(!necesidad.Estado==true ? "post--cubierto" : "")">
                            <div class="post__header">
                                <span class="badge-status @claseEstado">Estatus: @textoEstado</span>
                                <span>Publicado el: @(necesidad.Fecha != null ? necesidad.Fecha.Value.ToString("dd/MM/yyyy") : "")</span>
                            </div>
                            <h3 class="post__title" style="margin-top: 0.5rem;">@necesidad.Titulo</h3>
                            <p class="post__content" style="margin-top: 0.5rem;">@necesidad.Descripcion</p>
                        </article>
                    }
                </div>
            </div>

            <div id="tab-necesidades" class="tab-content">
                <h2 style="color: var(--primary); font-size: 1.25rem; margin-bottom: 1rem;">📑 Historial de Requerimientos Escolares</h2>

                <div class="feed">
                    <article class="card post">
                        <div class="post__header">
                            <span class="badge-status badge-status--activo">Estatus: Activo</span>
                            <span>Publicado el: 27/05/2026</span>
                        </div>
                        <h3 class="post__title" style="margin-top: 0.5rem;">Falta de pintura acrílica para fachadas de salones</h3>
                        <p class="post__content" style="margin-top: 0.5rem;">Tenemos 3 salones vandalizados debido a las lluvias y graffitis. Requerimos aproximadamente 2 o 3 cubetas de pintura acrílica blanca o azul.</p>
                    </article>

                    <article class="card post post--cubierto">
                        <div class="post__header">
                            <span class="badge-status badge-status--cubierto">Estatus: Cubierto</span>
                            <span>Publicado el: 14/05/2026</span>
                        </div>
                        <h3 class="post__title" style="margin-top: 0.5rem;">Se solicitan tubos PVC para drenaje de patio</h3>
                        <p class="post__content" style="margin-top: 0.5rem;">Buscamos tramos de tubo de 4 pulgadas para canalizar adecuadamente el agua de las lluvias de la temporada.</p>
                    </article>
                </div>
            </div>

            <div id="tab-agradecimientos" class="tab-content">
                <h2 style="color: var(--success); font-size: 1.25rem; margin-bottom: 1rem;">❤️ Muro de Reconocimientos Comunitarios</h2>

                <div class="feed">
                    <div class="card post post--thanks">
                        <div class="post__header">
                            <span style="font-weight: bold; color: var(--success);">❤️ ¡Gracias a Carlos Mendoza!</span>
                            <span>Hace 2 semanas</span>
                        </div>
                        <h3 style="color: var(--success); font-size: 1.1rem; margin: 0.5rem 0;">Donación Recibida: Tubos de PVC</h3>
                        <p style="font-size: 0.95rem;">Queremos agradecer profundamente al donante Carlos Mendoza por hacernos llegar el material excedente de su obra. Gracias a su generosidad el patio ya no se inunda.</p>
                    </div>
                </div>
            </div>

        </main>
    </div>

    <script>
            function switchTab(event, tabId) {
                // 1. Ocultar todos los bloques de contenido de pestañas
                const contents = document.querySelectorAll('.tab-content');
                contents.forEach(content => content.classList.remove('active'));

                // 2. Quitar la línea activa de todos los botones de la barra superior
                const buttons = document.querySelectorAll('.tab-btn');
                buttons.forEach(btn => btn.classList.remove('active'));

                // 3. Mostrar el bloque de la pestaña seleccionada
                document.getElementById(tabId).classList.add('active');

                // 4. Marcar el botón actual como activo para pintar la barra azul inferior
                event.currentTarget.classList.add('active');
            }
    </script>
</body>
</html>