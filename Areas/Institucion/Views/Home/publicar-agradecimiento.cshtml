@model HackaTec.Areas.Institucion.ViewModels.PublicacionesAgradecimientoViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crear Agradecimiento - LAZO</title>
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true">
</head>
<body>
    <div class="app-container">
        <nav class="navbar">
            <div class="navbar__brand">
                <img src="~/Images/logo.png" class="navbar__logo" alt="Logo LAZO" />
                <span class="navbar__title">LAZO</span>
            </div>
            <div class="navbar__nav-group">
                <ul class="navbar__menu">
                    <li><a href="/Feed" class="navbar__link">Inicio</a></li>
                    <li><a href="/Chat" class="navbar__link">Mensajes</a></li>
                    <li><a href="/Institucion/Home/Index" class="navbar__link">Mi Perfil</a></li>
                    <li><a href="/Account/Logout" class="navbar__link navbar__link--logout" onclick="return confirm('¿Cerrar sesión de la plataforma?')">Cerrar Sesión</a></li>
                </ul>
            </div>
        </nav>

        <main class="main-content" style="max-width: 650px;">
            <div style="margin-bottom: 1.5rem;">
                <h1 style="color: var(--primary); font-size: 1.75rem; margin-bottom: 0.25rem;">❤️ Redactar Nota de Gratitud</h1>
                <p style="color: var(--gray); font-size: 0.9rem;">Publica un agradecimiento enlazado para reconocer el apoyo de la comunidad y construir reputación.</p>
            </div>

            <div class="card" style="background-color: #f8fafc; border-left: 4px solid var(--primary-light); padding: 1rem; margin-bottom: 1.5rem;">
                <p style="font-size: 0.8rem; color: var(--gray); text-transform: uppercase; font-weight: bold; margin-bottom: 0.25rem;">Respondiendo a la Necesidad:</p>
                <h4 style="color: var(--primary); margin: 0;">Apoyo recibido para la institución</h4>
            </div>

            <div class="card">
                <form asp-area="Institucion" asp-controller="Home" asp-action="Agradecimientos" method="POST" enctype="multipart/form-data">

                    <input type="hidden" asp-for="IdPublicacionNecesidad" />

                    <div class="form-group mb-3">
                        <label asp-for="IdUsuarioDonante">Etiquetar al Donante / Colaborador *</label>
                        <div style="position: relative;">
                            <select asp-for="IdUsuarioDonante" asp-items="Model.ListaDonantes" class="form-control" required style="appearance: none; -webkit-appearance: none;">
                                <option value="" disabled selected>Selecciona al donante que te apoyó...</option>
                            </select>
                            <span style="position: absolute; right: 1rem; top: 50%; transform: translateY(-50%); pointer-events: none; color: var(--gray);">▼</span>
                        </div>
                        <span asp-validation-for="IdUsuarioDonante" class="text-danger" style="font-size: 0.85rem; color: red;"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Descripcion">Describe el resultado final o comparte tu testimonio *</label>
                        <textarea asp-for="Descripcion" class="form-control" rows="5" style="resize: vertical;" placeholder="Cuéntale a la comunidad cómo se usó el material excedente donado y el impacto positivo que tuvo en los alumnos..." required></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger" style="font-size: 0.85rem; color: red;"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="ArchivoFotografia">Evidencia Fotográfica del Resultado Final</label>
                        <div style="border: 2px dashed var(--gray); padding: 1.5rem; border-radius: 8px; text-align: center; background: #f9fafb;">
                            <input asp-for="ArchivoFotografia" class="form-control" accept=".jpg,.jpeg,.png" style="border: none; background: transparent; padding: 0;">
                        </div>
                    </div>

                    <div style="display: flex; gap: 1rem; justify-content: flex-end; margin-top: 2rem;">
                        <a href="/Institucion/Home/Index" class="btn" style="background: var(--light); color: var(--dark);">Cancelar</a>
                        <button type="submit" class="btn btn--success" style="padding: 0.6rem 1.5rem; background-color: #28a745; color: white; border: none; border-radius: 4px;">
                            ❤️ Publicar Agradecimiento
                        </button>
                    </div>

                </form>
            </div>
        </main>
    </div>
</body>
</html>