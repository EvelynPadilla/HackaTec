@model HackaTec.Areas.Institucion.ViewModels.NecesidadViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Publicar Necesidad - Espacio Escolar</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <div class="app-container">
        <nav class="navbar">
            <div class="navbar__brand">🏫 Panel Escuela</div>
            <div class="navbar__nav-group">
                <ul class="navbar__menu">
                    <li><a href="feed.html" class="navbar__link">Ver Feed</a></li>
                    <li><a href="perfil-escuela.html" class="navbar__link">Mi Historial</a></li>
                    <li><a href="login.html" class="navbar__link navbar__link--logout" onclick="return confirm('¿Cerrar sesión de la institución?')">Cerrar Sesión 🚪</a></li>
                </ul>
            </div>
        </nav>

        <main class="main-content" style="max-width: 700px;">
            <div style="margin-bottom: 1.5rem;">
                <h2 style="color: var(--primary);">Nueva Solicitud de Infraestructura</h2>
                <p style="color: var(--gray); font-size: 0.9rem;">Describe de forma clara el material excedente que tu plantel necesita para mitigar el rezago o reparar daños.</p>
            </div>

            <div class="card">
                <form id="form-publicar-post" action="feed.html" method="POST" enctype="multipart/form-data">

                    <div class="form-group">
                        <label for="titulo-post">¿Qué material o insumo necesitan? (Título breve) *</label>
                        <input type="text" id="titulo-post" class="form-control" placeholder="Ej: Se solicitan 4 láminas para techar desayunador" required>
                    </div>

                    <div class="form-group">
                        <label for="contenido-post">Explica la situación o el uso que se le dará al material *</label>
                        <textarea id="contenido-post" class="form-control" rows="5" style="resize: vertical;" placeholder="Detalla las dimensiones, el estado del área actual y por qué el excedente de otra obra puede solucionar el problema del plantel..." required></textarea>
                    </div>

                    <div class="form-group">
                        <label for="evidencia-foto">Evidencia Fotográfica del Área Escolar (Recomendado - Máx 5MB)</label>
                        <div style="border: 2px dashed var(--gray); padding: 1.5rem; border-radius: var(--border-radius); text-align: center; background: #f9fafb;">
                            <input type="file" id="evidencia-foto" class="form-control" accept=".jpg,.jpeg,.png" style="border: none; background: transparent; padding: 0;">
                            <p style="font-size: 0.8rem; color: var(--gray); margin-top: 0.5rem;">Formatos admitidos: JPG, JPEG o PNG. Se comprimirá automáticamente en el servidor.</p>
                        </div>
                    </div>

                    <div style="display: flex; gap: 1rem; justify-content: flex-end; margin-top: 2rem;">
                        <a href="feed.html" class="btn" style="background: var(--light); color: var(--dark);">Cancelar</a>
                        <button type="submit" class="btn btn--success">Publicar en el Feed Comunitario</button>
                    </div>
                </form>
            </div>
        </main>
    </div>
</body>
</html>
