@model HackaTec.Areas.Institucion.ViewModels.PublicarNecesidadViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Publicar Necesidad - Espacio Escolar</title>
    <link rel="stylesheet" href="~/styles.css">
</head>
<body>
    <div class="app-container">
        <nav class="navbar">
            <div class="navbar__brand">🏫 Panel Escuela</div>
            <div class="navbar__nav-group">
                <ul class="navbar__menu">
                    <li><a asp-action="Feed" asp-controller="Feed" asp-area="" class="navbar__link">Ver Feed</a></li>
                    <li><a asp-action="Index" asp-controller="Home" asp-area="Institucion" class="navbar__link">Mi Historial</a></li>
                    <li><a asp-action="Logout" asp-controller="Account" asp-area="Donante" class="navbar__link navbar__link--logout" onclick="return confirm('¿Cerrar sesión de la institución?')">Cerrar Sesión 🚪</a></li>
                </ul>
            </div>
        </nav>

        <main class="main-content" style="max-width: 700px;">
            <div style="margin-bottom: 1.5rem;">
                <h2 style="color: var(--primary);">Nueva Solicitud de Infraestructura</h2>
                <p style="color: var(--gray); font-size: 0.9rem;">Describe de forma clara el material excedente que tu plantel necesita para mitigar el rezago o reparar daños.</p>
            </div>

            <div class="card">

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger" style="background: #f8d7da; color: #721c24; padding: 1rem; border-radius: var(--border-radius); margin-bottom: 1rem;">
                        @foreach (var error in ViewData.ModelState[""].Errors)
                        {
                            <p>@error.ErrorMessage</p>
                        }
                    </div>
                }

                <form asp-action="PublicarNecesidad" asp-controller="Home" Institucion" method="post">
                    
                    <input type="hidden" asp-for="IdInstitucion" />

                    <div class="form-group">
                        <label asp-for="Titulo">¿Qué material o insumo necesitan? (Título breve) *</label>
                        <input asp-for="Titulo" class="form-control" placeholder="Ej: Se solicitan 4 láminas para techar desayunador" required />
                        <span asp-validation-for="Titulo" class="text-danger" style="color: #dc3545; font-size: 0.875rem;"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Descripcion">Explica la situación o el uso que se le dará al material *</label>
                        <textarea asp-for="Descripcion" class="form-control" rows="5" style="resize: vertical;" placeholder="Detalla las dimensiones, el estado del área actual y por qué el excedente de otra obra puede solucionar el problema del plantel..." required></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger" style="color: #dc3545; font-size: 0.875rem;"></span>
                    </div>

                    <div style="display: flex; gap: 1rem; justify-content: flex-end; margin-top: 2rem;">
                        <a asp-action="Feed" asp-controller="Feed" asp-area="" class="btn" style="background: var(--light); color: var(--dark);">Cancelar</a>
                        <input type="submit" class="btn btn--success" value="Publicar en el Feed Comunitario" />
                    </div>
                </form>
            </div>
        </main>
    </div>

</body>
</html>